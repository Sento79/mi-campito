"plagas": [
 {"id":"pulgon","nombre":"Pulgones","cient":"Aphis spiraecola, A. gossypii, Toxoptera aurantii","tipo":"insecto","meses":[3,4,5,9,10],"esp":"todas","que":"Colonias en brotes tiernos que se enrollan; melaza y negrilla.","umbral":"Orientativo: más del 25 % de brotes ocupados en clementinas (10 % en Navel no es tan grave). Hay muchos enemigos naturales: mira antes de tratar."},
 {"id":"trips","nombre":"Trips de la piel","cient":"Pezothrips kellyanus","tipo":"insecto","meses":[4,5,6],"esp":"todas","que":"Anillo de cicatriz alrededor del cáliz del fruto recién cuajado.","umbral":"Vigilar desde la caída de pétalos hasta que el fruto mide unos 2 cm."},
 {"id":"minador","nombre":"Minador de los cítricos","cient":"Phyllocnistis citrella","tipo":"insecto","meses":[6,7,8,9,10],"esp":"todas","que":"Galerías plateadas en hojas tiernas.","umbral":"Solo es importante en árboles jóvenes y replantes. En adultos no suele tratarse."},
 {"id":"aranya","nombre":"Araña roja","cient":"Tetranychus urticae","tipo":"ácaro","meses":[4,5,6,7,8],"esp":"mandarino","que":"Manchas amarillas en el haz de la hoja y en el fruto de clementinas.","umbral":"Orientativo: más del 20 % de hojas ocupadas en primavera. Favorecida por el polvo y las malas hierbas."},
 {"id":"panonychus","nombre":"Ácaro rojo","cient":"Panonychus citri","tipo":"ácaro","meses":[10,11,12,1,2,3],"esp":"todas","que":"Hojas y frutos con aspecto plateado o bronceado.","umbral":"Vigilar sobre todo en otoño e invierno."},
 {"id":"maravillas","nombre":"Ácaro de las maravillas","cient":"Aceria sheldoni","tipo":"ácaro","meses":[3,4,5,6,7,8,9,10],"esp":"limonero","que":"Frutos y brotes deformados en limonero.","umbral":"Revisar yemas y frutos pequeños en primavera."},
 {"id":"piojo","nombre":"Piojo rojo de California","cient":"Aonidiella aurantii","tipo":"cochinilla","meses":[5,6,7,8,9,10],"esp":"todas","que":"Escudos redondos rojizos en fruto, ramas y hojas.","umbral":"Tres generaciones al año. Se trata cuando salen las larvas (mayo-junio, julio-agosto y septiembre-octubre). Más del 2 % de fruta con piojo en cosecha indica que hay que actuar la campaña siguiente."},
 {"id":"cotonet","nombre":"Cotonet","cient":"Planococcus citri","tipo":"cochinilla","meses":[6,7,8,9],"esp":"todas","que":"Masas algodonosas bajo el cáliz y entre frutos que se tocan.","umbral":"Orientativo: más del 20 % de frutos con cotonet bajo el cáliz en julio-agosto."},
 {"id":"cotonet_sa","nombre":"Cotonet de Sudáfrica (de Les Valls)","cient":"Delottococcus aberiae","tipo":"cochinilla","meses":[5,6,7,8],"esp":"todas","que":"Deforma el fruto pequeño. Plaga muy dañina en expansión en Valencia y Castellón.","umbral":"Revisar fruto recién cuajado. Avisar a sanidad vegetal si aparece en zonas nuevas."},
 {"id":"mosca_blanca","nombre":"Mosca blanca algodonosa","cient":"Aleurothrixus floccosus","tipo":"insecto","meses":[6,7,8,9,10],"esp":"todas","que":"Envés de hojas con secreción algodonosa, mucha melaza y negrilla.","umbral":"Su parasitoide Cales noacki suele controlarla. Tratar solo si hay mucha negrilla."},
 {"id":"mosca_negra","nombre":"Mosca negra de los cítricos","cient":"Aleurocanthus spiniferus","tipo":"insecto","meses":[5,6,7,8,9,10],"esp":"todas","que":"Larvas negras con espinas en el envés de la hoja. Plaga de cuarentena.","umbral":"Si la ves en una zona nueva, avisa a sanidad vegetal."},
