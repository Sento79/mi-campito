# ---------------------------------------------------------------------------
# ESD Control — variables de entorno. Copie a .env y ajuste. NO suba .env al repositorio.
# ---------------------------------------------------------------------------

# Conexión de la APLICACIÓN (rol esd_app: sin BYPASSRLS ni propiedad de tablas → RLS siempre aplica)
DATABASE_URL=postgres://esd_app:CAMBIAR_password_app@localhost:5432/esd

# Conexión de MIGRACIONES / mantenimiento (propietario del esquema). Solo scripts, nunca el servidor web.
MIGRATION_DATABASE_URL=postgres://esd_owner:CAMBIAR_password_owner@localhost:5432/esd

# Contraseña que el script de migración asigna al rol esd_app (debe coincidir con DATABASE_URL)
APP_DB_PASSWORD=CAMBIAR_password_app

# URL pública de la aplicación (se usa en los QR de etiquetas: <APP_URL>/a/<código>)
APP_URL=http://localhost:3000

# Cookies de sesión con flag Secure (true en producción con HTTPS)
COOKIE_SECURE=false

# Duración de la sesión en horas
SESSION_TTL_HOURS=12

# Almacenamiento de archivos: "local" (disco del servidor). Ruta fuera de /public.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Tamaño máximo de subida en MB
MAX_UPLOAD_MB=20

# Secreto para el endpoint de tareas programadas (POST /api/cron/alerts con cabecera Authorization: Bearer ...)
CRON_SECRET=

# Bootstrap del primer administrador (npm run db:bootstrap)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ORG_SLUG=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Datos de demostración (npm run db:seed:demo). Se crean en una organización separada marcada como DEMO.
DEMO_SEED_ENABLED=false
DEMO_PASSWORD=
