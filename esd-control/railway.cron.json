{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": ["/esd-control/**"]
  },
  "deploy": {
    "startCommand": "npm run jobs:alerts",
    "cronSchedule": "17 5 * * *",
    "restartPolicyType": "NEVER"
  }
}
