{
  "name": "esd-control",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de control ESD: inventario, mediciones, planos, campañas, no conformidades, instrumentos, etiquetas, informes y auditoría.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "db:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "jobs:alerts": "tsx scripts/run-alerts.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.1",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "bcryptjs": "3.0.2",
    "bwip-js": "4.5.4",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "idb": "8.0.3",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "papaparse": "5.5.3",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "0.17.2",
    "postgres": "3.4.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.62.0",
    "recharts": "2.15.4",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/pdfkit": "0.17.7",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
